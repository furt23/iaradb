---
import LogoMark from './LogoMark.astro';

const tabs = [
  {
    id: 'notebook',
    label: 'Reactive Notebooks',
    badge: '.py · marimo',
    caption: 'Mix Python LazyFrames and SQL in one reactive graph. Plain .py files diff cleanly in Git.',
  },
  {
    id: 'wrangler',
    label: 'Data Wrangler',
    badge: '13 recipe steps',
    caption: 'Build visual cleaning recipes over all rows in the kernel and export clean DataFrame or SQL code.',
  },
  {
    id: 'analyze',
    label: 'Catalog & Analyze',
    badge: 'Delta · Profiler',
    caption: 'Browse multi-catalog schemas, time-travel Delta Lake commits, and inspect per-operator profiles.',
  },
  {
    id: 'jobs',
    label: 'Jobs & AWS Compute',
    badge: 'DAGs · EC2 Spot',
    caption: 'Schedule multi-task TOML pipelines on cron and spin up ephemeral EC2 Spot clusters over SSH.',
  },
];

const priorities = [
  { short: 'URGENT', name: '1-URGENT', count: '300,343', rev: '$42.8M', value: 300343 },
  { short: 'HIGH', name: '2-HIGH', count: '300,091', rev: '$42.6M', value: 300091 },
  { short: 'MEDIUM', name: '3-MEDIUM', count: '298,723', rev: '$42.1M', value: 298723 },
  { short: 'LOW', name: '4-NOT SPEC', count: '300,254', rev: '$42.5M', value: 300254 },
  { short: 'NONE', name: '5-LOW', count: '300,589', rev: '$42.9M', value: 300589 },
];
const maxPriority = Math.max(...priorities.map((p) => p.value));
const priorityCols = priorities.map((p) => ({
  ...p,
  pct: ((p.value / maxPriority) * 100).toFixed(1),
}));

const studioPillars = [
  {
    jump: 'workspace',
    eyebrow: 'notebooks/*.py',
    title: 'Git-native marimo notebooks',
    text: 'Every cell is a pure Python function stored in a plain .py file. Run dependent cells automatically or mark them stale until triggered, with Jedi autocomplete and live SQL diagnostics.',
  },
  {
    jump: 'sql',
    eyebrow: 'Python ⇄ SQL',
    title: 'One shared namespace',
    text: 'Query any Python LazyFrame by variable name inside a SQL cell, and read any SQL cell result as a DataFrame in downstream Python cells. Named widgets bind directly to :param placeholders.',
  },
  {
    jump: 'wrangler',
    eyebrow: '/wrangle/<table>',
    title: 'Visual Data Wrangler',
    text: 'Filter, impute nulls, deduplicate, trim, regex replace, split, cast and one-hot encode. Steps compile into one kernel query with full-column histograms and export to Python or SQL.',
  },
  {
    jump: 'data',
    eyebrow: '.iara/catalog.toml',
    title: 'Multi-catalog & Delta history',
    text: 'Mount local directories and s3:// buckets side by side, auto-discover schema folders, inspect Parquet statistics, and query or restore prior Delta Lake table commits.',
  },
  {
    jump: 'analyze',
    eyebrow: '/analyze',
    title: 'Live profiles & spooled results',
    text: 'Page through results larger than RAM (spooled to disk above 128 MB), build kernel-aggregated charts, and open operator DAGs with row counts, timings and spilled bytes.',
  },
  {
    jump: 'jobs',
    eyebrow: 'jobs/*.toml · EC2',
    title: 'Cron DAGs & AWS Spot clusters',
    text: 'Define multi-task DAGs with retries, parameter overrides and webhook alerts. Attach notebooks or jobs to on-demand or Spot EC2 clusters with custom pip libraries and time limits.',
  },
];

const railSections = [
  { name: 'Workspace', key: 'workspace', tab: 'notebook' },
  { name: 'Data', key: 'data', tab: 'analyze' },
  { name: 'Wrangler', key: 'wrangler', tab: 'wrangler' },
  { name: 'SQL', key: 'sql', tab: 'notebook' },
  { name: 'Analyze', key: 'analyze', tab: 'analyze' },
  { name: 'Jobs', key: 'jobs', tab: 'jobs' },
  { name: 'Compute', key: 'compute', tab: 'jobs' },
  { name: 'Git', key: 'git', tab: 'notebook' },
];
---

<section class="section" id="studio">
  <div class="container">
    <div class="studio-head" data-reveal>
      <div>
        <span class="eyebrow">Iara Studio</span>
        <h1>A full analytics workspace, right on your files.</h1>
        <p class="lede">
          Iara Studio runs in the browser over a local folder or a shared S3 bucket. Notebooks stay plain <code>.py</code> files,
          queries stay <code>.sql</code> files, and jobs stay <code>.toml</code> files — so everything diffs and reviews in Git while
          queries execute in the Rust engine.
        </p>
      </div>

      <div class="studio-cli" aria-label="Launch Iara Studio from the terminal">
        <div class="studio-cli__top">
          <span class="studio-cli__label">Terminal</span>
          <span class="studio-cli__port">http://localhost:3870</span>
        </div>
        <pre class="studio-cli__code"><code><span class="prompt">$</span> iara serve examples/workspace</code></pre>
      </div>
    </div>

    <!-- Interactive Studio Workspace Explorer -->
    <div class="studio-explorer" data-reveal="scale" data-studio-explorer>
      <div class="studio-tabs" role="tablist" aria-label="Iara Studio views">
        {tabs.map((t, idx) => (
          <button
            type="button"
            role="tab"
            class={`studio-tab ${idx === 0 ? 'is-active' : ''}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`studio-panel-${t.id}`}
            id={`studio-tab-${t.id}`}
            data-studio-tab={t.id}
          >
            <span class="studio-tab__top">
              <span class="studio-tab__title">{t.label}</span>
              <span class="studio-tab__badge">{t.badge}</span>
            </span>
            <span class="studio-tab__desc">{t.caption}</span>
          </button>
        ))}
      </div>

      <div class="window">
        <!-- Interactive Toast Notification -->
        <div class="studio-toast" data-studio-toast hidden style="display: none;" role="status" aria-live="polite">
          <span class="studio-toast__text" data-studio-toast-text></span>
          <button type="button" class="studio-toast__close" data-studio-toast-close aria-label="Dismiss">✕</button>
        </div>

        <!-- Search & Command Palette Modal -->
        <div class="search-modal" data-search-modal hidden style="display: none;">
          <div class="search-modal__backdrop" data-search-close></div>
          <div class="search-modal__dialog" role="dialog" aria-modal="true" aria-label="Quick Search">
            <div class="search-modal__header">
              <input
                type="text"
                class="search-modal__input"
                placeholder="Jump to a notebook, table, query, or cluster..."
                data-search-input
                aria-label="Filter navigation targets"
              />
              <button type="button" class="search-modal__close" data-search-close aria-label="Close search">✕</button>
            </div>
            <div class="search-modal__list">
              <button type="button" class="search-modal__item" data-search-target="workspace">
                <span class="search-modal__badge">Workspace</span>
                <strong>notebooks/revenue.py</strong>
                <span class="muted small">marimo reactive graph</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="data">
                <span class="search-modal__badge">Data</span>
                <strong>main.orders</strong>
                <span class="muted small">Delta Lake table v18</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="wrangler">
                <span class="search-modal__badge">Wrangler</span>
                <strong>main.customer</strong>
                <span class="muted small">clean &amp; filter recipe</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="sql">
                <span class="search-modal__badge">SQL</span>
                <strong>queries/regional_kpi.sql</strong>
                <span class="muted small">analytical query with parameters</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="analyze">
                <span class="search-modal__badge">Analyze</span>
                <strong>Query Analyze /analyze/9f3a8c12</strong>
                <span class="muted small">operator DAG timeline</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="jobs">
                <span class="search-modal__badge">Jobs</span>
                <strong>jobs/nightly_sales.toml</strong>
                <span class="muted small">cron scheduled DAG</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="compute">
                <span class="search-modal__badge">Compute</span>
                <strong>analytics-xl</strong>
                <span class="muted small">m7i.4xlarge EC2 Spot</span>
              </button>
              <button type="button" class="search-modal__item" data-search-target="git">
                <span class="search-modal__badge">Git</span>
                <strong>Git Status &amp; Diff</strong>
                <span class="muted small">branch main (2 modified)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- 48px Studio App Bar -->
        <div class="window__bar">
          <div class="window__brand">
            <LogoMark size={20} />
            <span class="window__name">Iara</span>
            <span class="window__path">/ tpch-demo</span>
          </div>
          <button type="button" class="window__search" data-search-trigger aria-label="Search notebooks, queries and tables">
            <span>Search notebooks, queries and tables</span>
            <kbd>Ctrl K</kbd>
          </button>
          <div class="window__meta">
            <button type="button" class="cluster-pill" data-cluster-pill title="Inspect EC2 compute cluster">
              <span class="cluster-pill__dot"></span>
              m7i.4xlarge · 16 vCPUs
            </button>
          </div>
        </div>

        <div class="window__body">
          <!-- Left Navigation Rail -->
          <nav class="rail" aria-label="Studio tools">
            {railSections.map((item, i) => (
              <button
                type="button"
                class={`rail__item ${i === 0 ? 'rail__item--active' : ''}`}
                data-rail-target={item.key}
                data-tab-parent={item.tab}
                title={item.name}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span class="rail__dot"></span>
                <span class="rail__label">{item.name}</span>
              </button>
            ))}
          </nav>

          <!-- Panel 1: Reactive Notebooks -->
          <div
            class="studio-panel is-active"
            role="tabpanel"
            id="studio-panel-notebook"
            aria-labelledby="studio-tab-notebook"
            data-studio-panel="notebook"
          >
            <div class="notebook-layout">
              <div class="notebook-main">
                <!-- Tab strip & Widget bar -->
                <div class="workbench-strip" role="tablist" aria-label="Open files">
                  <button type="button" class="tab-chip tab-chip--active" data-file-tab="revenue" role="tab" aria-selected="true">notebooks/revenue.py</button>
                  <button type="button" class="tab-chip" data-file-tab="sql" role="tab" aria-selected="false">queries/regional_kpi.sql</button>
                  <button type="button" class="tab-chip" data-file-tab="git" role="tab" aria-selected="false">Git Status</button>
                  <span class="workbench-strip__right">Kernel · idle · 16 cores</span>
                </div>

                <!-- View 1: notebooks/revenue.py -->
                <div class="file-view" data-file-view="revenue">
                  <div class="widget-bar">
                    <span class="widget-bar__tag">Widgets</span>
                    <div class="widget-pill">
                      <span class="widget-pill__label">region</span>
                      <span class="widget-pill__val">AMERICA ▾</span>
                    </div>
                    <div class="widget-pill">
                      <span class="widget-pill__label">segment</span>
                      <span class="widget-pill__val">BUILDING ▾</span>
                    </div>
                    <div class="widget-pill">
                      <span class="widget-pill__label">min_acctbal</span>
                      <span class="widget-pill__val">1,000</span>
                    </div>
                  </div>

                  <!-- Cell 1: Python LazyFrame -->
                  <div class="cell">
                    <div class="cell__head">
                      <span class="cell__lang">Python · cell_1</span>
                      <span class="cell__status">defined orders · 2 ms</span>
                    </div>
                    <pre class="code-line"><span class="kw">from</span> iara <span class="kw">import</span> functions <span class="kw">as</span> F
orders = ws.table(<span class="str">"orders"</span>).filter(F.col(<span class="str">"o_orderdate"</span>) &gt;= <span class="str">"1995-01-01"</span>)</pre>
                    <div class="frame-line">
                      <span class="frame-line__name">orders</span>
                      <span class="frame-line__kind">LazyFrame · 9 columns</span>
                      <span class="frame-line__cols">[o_orderkey: integer, o_custkey: integer, o_orderpriority: text, o_totalprice: decimal(15,2), …]</span>
                    </div>
                  </div>

                  <!-- Cell 2: SQL Cell sharing Python variable & widget parameter -->
                  <div class="cell cell--active">
                    <div class="cell__head">
                      <span class="cell__lang cell__lang--sql">SQL · cell_2 → by_priority</span>
                      <span class="cell__status cell__status--ok">5 rows · 38 ms · 0 B spilled</span>
                    </div>
                    <pre class="code-line"><span class="kw">select</span> o_orderpriority, <span class="fn">count</span>(*) <span class="kw">as</span> orders, <span class="fn">sum</span>(o_totalprice) <span class="kw">as</span> revenue
<span class="kw">from</span> orders <span class="kw">where</span> o_mktsegment = <span class="num">:segment</span>
<span class="kw">group by</span> 1 <span class="kw">order by</span> 1</pre>

                    <div class="out-tabs" role="tablist" aria-label="Output views">
                      <button type="button" class="out-tab out-tab--active" data-out-tab="table" role="tab" aria-selected="true">Table · 5 rows</button>
                      <button type="button" class="out-tab" data-out-tab="chart" role="tab" aria-selected="false">Chart · Horizontal</button>
                      <button type="button" class="out-tab" data-out-tab="profile" role="tab" aria-selected="false">Profile · 38 ms</button>
                      <button type="button" class="out-tab out-tab--action" data-out-tab="wrangle" title="Open in Data Wrangler">Wrangle →</button>
                    </div>

                    <div class="cell__out">
                      <!-- Table View -->
                      <div class="out-view" data-out-view="table">
                        <table class="table">
                          <thead>
                            <tr>
                              <th scope="col">o_orderpriority <span class="th-type">text</span></th>
                              <th scope="col" class="num">orders <span class="th-type">integer</span></th>
                              <th scope="col" class="num">revenue <span class="th-type">decimal</span></th>
                            </tr>
                          </thead>
                          <tbody>
                            {priorities.map((p) => (
                              <tr>
                                <td>{p.name}</td>
                                <td class="num">{p.count}</td>
                                <td class="num">{p.rev}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      <!-- Chart View -->
                      <div class="out-view" data-out-view="chart" hidden>
                        <div class="studio-hchart" aria-label="Order counts by priority">
                          <div class="studio-hchart__title">Orders by priority (kernel-aggregated)</div>
                          <div class="studio-hchart__cols">
                            {priorityCols.map((c) => (
                              <div class="studio-hchart__col">
                                <div class="studio-hchart__track">
                                  <span class="studio-hchart__bar hchart__col-bar" style={`height: ${c.pct}%`}></span>
                                </div>
                                <span class="studio-hchart__label">{c.short}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>

                      <!-- Profile View -->
                      <div class="out-view" data-out-view="profile" hidden>
                        <div class="cell-profile-card">
                          <div class="side-block__title">Operator breakdown</div>
                          <div class="prof-row"><span>ParquetScan (orders.parquet)</span><span class="num">14 ms · 1.5M rows</span></div>
                          <div class="prof-row"><span>Filter (o_mktsegment = :segment)</span><span class="num">4 ms · 300,091 rows</span></div>
                          <div class="prof-row"><span>HashAggregate (group by 1)</span><span class="num">20 ms · 5 rows</span></div>
                          <div class="prof-row prof-row--muted"><span>Memory pool</span><span class="num">94 MB peak · 0 B spilled</span></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- View 2: queries/regional_kpi.sql -->
                <div class="file-view" data-file-view="sql" hidden>
                  <div class="cell cell--active">
                    <div class="cell__head">
                      <span class="cell__lang cell__lang--sql">SQL File · queries/regional_kpi.sql</span>
                      <span class="cell__status cell__status--ok">5 rows · 34 ms · read_parquet pushdown</span>
                    </div>
                    <pre class="code-line"><span class="kw">select</span>
    o_orderpriority,
    <span class="fn">count</span>(*) <span class="kw">as</span> orders,
    <span class="fn">sum</span>(o_totalprice) <span class="kw">as</span> revenue
<span class="kw">from</span> <span class="fn">read_parquet</span>(<span class="str">'s3://warehouse/tpch/orders'</span>)
<span class="kw">where</span> o_orderdate &gt;= <span class="str">'1995-01-01'</span>
  <span class="kw">and</span> o_mktsegment = <span class="num">:segment</span>
<span class="kw">group by</span> <span class="num">1</span>
<span class="kw">order by</span> <span class="num">1</span></pre>

                    <div class="out-tabs" role="tablist">
                      <button type="button" class="out-tab out-tab--active" data-sql-tab="table">Table · 5 rows</button>
                      <button type="button" class="out-tab" data-sql-tab="chart">Chart · Horizontal</button>
                    </div>

                    <div class="cell__out">
                      <div class="sql-out-view" data-sql-view="table">
                        <table class="table">
                          <thead>
                            <tr>
                              <th scope="col">o_orderpriority <span class="th-type">text</span></th>
                              <th scope="col" class="num">orders <span class="th-type">integer</span></th>
                              <th scope="col" class="num">revenue <span class="th-type">decimal</span></th>
                            </tr>
                          </thead>
                          <tbody>
                            {priorities.map((p) => (
                              <tr>
                                <td>{p.name}</td>
                                <td class="num">{p.count}</td>
                                <td class="num">{p.rev}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      <div class="sql-out-view" data-sql-view="chart" hidden>
                        <div class="studio-hchart" aria-label="Order counts by priority">
                          <div class="studio-hchart__title">Orders by priority (kernel-aggregated)</div>
                          <div class="studio-hchart__cols">
                            {priorityCols.map((c) => (
                              <div class="studio-hchart__col">
                                <div class="studio-hchart__track">
                                  <span class="studio-hchart__bar hchart__col-bar" style={`height: ${c.pct}%`}></span>
                                </div>
                                <span class="studio-hchart__label">{c.short}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- View 3: Git Status -->
                <div class="file-view" data-file-view="git" hidden>
                  <div class="cell cell--active">
                    <div class="cell__head">
                      <span class="cell__lang">Git · Branch main · Clean origin/main sync</span>
                      <span class="cell__status cell__status--ok">2 tracked files modified</span>
                    </div>
                    <div class="git-box">
                      <div class="git-box__files">
                        <div class="git-file git-file--staged">
                          <span class="git-pill git-pill--staged">staged</span>
                          <code>queries/regional_kpi.sql</code>
                          <span class="muted small">+8 lines</span>
                        </div>
                        <div class="git-file git-file--modified">
                          <span class="git-pill git-pill--mod">modified</span>
                          <code>notebooks/revenue.py</code>
                          <span class="muted small">+12, -4 lines</span>
                        </div>
                      </div>
                      <div class="git-diff-card">
                        <div class="side-block__title">Git Diff · Plain Python file</div>
                        <pre class="code-mini"><span class="diff-ctx">@@ -18,4 +18,6 @@</span>
<span class="diff-del">- orders = ws.table("orders")</span>
<span class="diff-add">+ orders = ws.table("orders").filter(F.col("o_orderdate") &gt;= "1995-01-01")</span>
<span class="diff-ctx"> # marimo reactive graph diffs cleanly in git</span></pre>
                        <div class="git-actions">
                          <button type="button" class="button button--primary button--sm" data-git-commit>Commit to main</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Side Panel: Outline & Variables -->
              <aside class="notebook-side">
                <div class="side-block">
                  <div class="side-block__title">Variables (3)</div>
                  <div class="var-row">
                    <code>segment</code>
                    <span>"BUILDING"</span>
                  </div>
                  <div class="var-row">
                    <code>orders</code>
                    <span>LazyFrame · 9 cols</span>
                  </div>
                  <div class="var-row">
                    <code>by_priority</code>
                    <span>DataFrame · 5×3</span>
                  </div>
                </div>
                <div class="side-block">
                  <div class="side-block__title">Pipeline profile</div>
                  <div class="prof-row">
                    <span>Scan + Filter</span>
                    <span>14 ms</span>
                  </div>
                  <div class="prof-row">
                    <span>HashAggregate</span>
                    <span>24 ms</span>
                  </div>
                  <div class="prof-row prof-row--muted">
                    <span>Peak memory</span>
                    <span>94 MB / 8 GB</span>
                  </div>
                </div>
              </aside>
            </div>
          </div>

          <!-- Panel 2: Data Wrangler -->
          <div
            class="studio-panel"
            role="tabpanel"
            id="studio-panel-wrangler"
            aria-labelledby="studio-tab-wrangler"
            data-studio-panel="wrangler"
            hidden
          >
            <div class="wrangler-toolbar">
              <code class="wrangler-table-name">main.customer</code>
              <button type="button" class="wrangler-btn is-active" data-wrangler-tool="filter">Filter</button>
              <button type="button" class="wrangler-btn" data-wrangler-tool="clean">Clean and impute</button>
              <button type="button" class="wrangler-btn" data-wrangler-tool="text">Text</button>
              <button type="button" class="wrangler-btn" data-wrangler-tool="columns">Columns</button>
              <span class="wrangler-count" data-wrangler-count>29,984 of 150,000 rows × 8 cols</span>
              <button type="button" class="wrangler-btn wrangler-btn--primary" data-wrangler-export>Export code</button>
            </div>

            <div class="wrangler-layout">
              <div class="wrangler-steps">
                <div class="side-block__title">STEPS (4)</div>
                <button type="button" class="step-item" data-wrangler-step="0">Source · main.customer</button>
                <button type="button" class="step-item" data-wrangler-step="1">1. Filter c_mktsegment = "AUTOMOBILE"</button>
                <button type="button" class="step-item" data-wrangler-step="2">2. Trim whitespace · c_name</button>
                <button type="button" class="step-item" data-wrangler-step="3">3. Fill nulls · c_acctbal → 0.00</button>
                <button type="button" class="step-item step-item--active" data-wrangler-step="4">4. Sort c_acctbal descending</button>
              </div>

              <div class="wrangler-main">
                <table class="table wrangler-grid">
                  <thead>
                    <tr>
                      <th>
                        <div>c_custkey <span class="th-type">integer</span></div>
                        <div class="qbar"><span style="width: 100%"></span></div>
                        <div class="qmeta">100% valid · 29.9k distinct</div>
                      </th>
                      <th>
                        <div>c_name <span class="th-type">text</span></div>
                        <div class="qbar"><span style="width: 100%"></span></div>
                        <div class="qmeta">trimmed · 0 nulls</div>
                      </th>
                      <th>
                        <div>c_nation <span class="th-type">text</span></div>
