<script is:inline>
  (() => {
    const explorer = document.querySelector('[data-studio-explorer]');
    if (!explorer) return;

    const tabButtons = Array.from(explorer.querySelectorAll('[data-studio-tab]'));
    const panels = Array.from(explorer.querySelectorAll('[data-studio-panel]'));
    const railItems = Array.from(explorer.querySelectorAll('[data-rail-target]'));

    // Toast notifications
    const toast = explorer.querySelector('[data-studio-toast]');
    const toastText = explorer.querySelector('[data-studio-toast-text]');
    const toastClose = explorer.querySelector('[data-studio-toast-close]');
    let toastTimeout;

    function showToast(msg) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.hidden = false;
      toast.classList.add('is-visible');
      toast.style.display = 'flex';
      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('is-visible');
        toast.hidden = true;
        toast.style.display = 'none';
      }, 4000);
    }

    toastClose?.addEventListener('click', (e) => {
      e.preventDefault();
      clearTimeout(toastTimeout);
      if (toast) {
        toast.classList.remove('is-visible');
        toast.hidden = true;
        toast.style.display = 'none';
      }
    });

    // Main Tab Activation
    function activateTab(tabId, railKey) {
      tabButtons.forEach((btn) => {
        const active = btn.getAttribute('data-studio-tab') === tabId;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-studio-panel') === tabId;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });

      // Synchronize sidebar rail
      const targetKey = railKey || (tabId === 'notebook' ? 'workspace' : tabId === 'analyze' ? 'data' : tabId === 'jobs' ? 'jobs' : tabId);
      railItems.forEach((item) => {
        const active = item.getAttribute('data-rail-target') === targetKey;
        item.classList.toggle('rail__item--active', active);
        item.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    // Direct Rail Navigation
    function activateRailItem(key) {
      if (key === 'workspace') {
        activateTab('notebook', 'workspace');
        switchFileView('revenue');
      } else if (key === 'sql') {
        activateTab('notebook', 'sql');
        switchFileView('sql');
      } else if (key === 'git') {
        activateTab('notebook', 'git');
        switchFileView('git');
      } else if (key === 'wrangler') {
        activateTab('wrangler', 'wrangler');
      } else if (key === 'data') {
        activateTab('analyze', 'data');
        const catalogPane = explorer.querySelector('.catalog-pane');
        if (catalogPane) catalogPane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else if (key === 'analyze') {
        activateTab('analyze', 'analyze');
        const analyzeMain = explorer.querySelector('.analyze-main');
        if (analyzeMain) analyzeMain.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else if (key === 'jobs') {
        activateTab('jobs', 'jobs');
        const jobsPane = explorer.querySelector('.jobs-pane');
        if (jobsPane) jobsPane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else if (key === 'compute') {
        activateTab('jobs', 'compute');
        const computePane = explorer.querySelector('.compute-pane');
        if (computePane) computePane.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // Top Tabs event listeners
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-studio-tab');
        if (id) activateTab(id);
      });
    });

    // Rail event listeners
    railItems.forEach((item) => {
      item.addEventListener('click', () => {
        const key = item.getAttribute('data-rail-target');
        if (key) activateRailItem(key);
      });
    });

    // File Tabs switching (revenue vs sql vs git)
    const fileTabs = Array.from(explorer.querySelectorAll('[data-file-tab]'));
    const fileViews = Array.from(explorer.querySelectorAll('[data-file-view]'));

    function switchFileView(targetView) {
      fileTabs.forEach((tab) => {
        const active = tab.getAttribute('data-file-tab') === targetView;
        tab.classList.toggle('tab-chip--active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      fileViews.forEach((view) => {
        const active = view.getAttribute('data-file-view') === targetView;
        view.hidden = !active;
      });
      if (targetView === 'sql') {
        railItems.forEach((r) => r.classList.toggle('rail__item--active', r.getAttribute('data-rail-target') === 'sql'));
      } else if (targetView === 'git') {
        railItems.forEach((r) => r.classList.toggle('rail__item--active', r.getAttribute('data-rail-target') === 'git'));
      } else if (targetView === 'revenue') {
        railItems.forEach((r) => r.classList.toggle('rail__item--active', r.getAttribute('data-rail-target') === 'workspace'));
      }
    }

    fileTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const view = tab.getAttribute('data-file-tab');
        if (view) switchFileView(view);
      });
    });

    // Output tabs in Cell 2 (Table vs Chart vs Profile vs Wrangle)
    const outTabs = Array.from(explorer.querySelectorAll('[data-out-tab]'));
    const outViews = Array.from(explorer.querySelectorAll('[data-out-view]'));
    outTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-out-tab');
        if (target === 'wrangle') {
          activateTab('wrangler', 'wrangler');
          showToast('Loaded table into Visual Data Wrangler');
          return;
        }
        outTabs.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('out-tab--active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        outViews.forEach((v) => {
          v.hidden = v.getAttribute('data-out-view') !== target;
        });
      });
    });

    // SQL standalone out tabs
    const sqlTabs = Array.from(explorer.querySelectorAll('[data-sql-tab]'));
    const sqlViews = Array.from(explorer.querySelectorAll('[data-sql-view]'));
    sqlTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-sql-tab');
        sqlTabs.forEach((b) => b.classList.toggle('out-tab--active', b === btn));
        sqlViews.forEach((v) => {
          v.hidden = v.getAttribute('data-sql-view') !== target;
        });
      });
    });

    // Catalog Table selection & Delta History
    const catalogTables = Array.from(explorer.querySelectorAll('[data-table-select]'));
    const catalogPanes = Array.from(explorer.querySelectorAll('[data-table-history]'));
    catalogTables.forEach((tableBtn) => {
      tableBtn.addEventListener('click', () => {
        const name = tableBtn.getAttribute('data-table-select');
        catalogTables.forEach((b) => b.classList.toggle('is-selected', b === tableBtn));
        catalogPanes.forEach((p) => {
          p.hidden = p.getAttribute('data-table-history') !== name;
        });
      });
    });

    // Delta History Actions
    explorer.querySelector('[data-delta-restore]')?.addEventListener('click', () => {
      showToast('✓ Restored main.orders to commit v17 (DELETE rolled back)');
    });
    explorer.querySelector('[data-delta-query]')?.addEventListener('click', () => {
      activateRailItem('sql');
      showToast('Querying main.orders VERSION AS OF 16');
    });
    explorer.querySelector('[data-catalog-query-lineitem]')?.addEventListener('click', () => {
      activateRailItem('sql');
      showToast('Opened main.lineitem in SQL editor');
    });
    explorer.querySelector('[data-catalog-to-wrangler]')?.addEventListener('click', () => {
      activateTab('wrangler', 'wrangler');
      showToast('Opened main.customer in Data Wrangler');
    });

    // Wrangler Tools & Step Items
    const wranglerSteps = Array.from(explorer.querySelectorAll('[data-wrangler-step]'));
    const wranglerCount = explorer.querySelector('[data-wrangler-count]');
    const stepCounts = ['150,000 rows × 8 cols', '30,000 rows × 8 cols', '30,000 rows × 8 cols', '29,984 rows × 8 cols', '29,984 rows × 8 cols'];
    wranglerSteps.forEach((step) => {
      step.addEventListener('click', () => {
        wranglerSteps.forEach((s) => s.classList.toggle('step-item--active', s === step));
        const idx = parseInt(step.getAttribute('data-wrangler-step') || '0', 10);
        if (wranglerCount && stepCounts[idx]) {
          wranglerCount.textContent = `${stepCounts[idx]} (at step ${idx})`;
        }
      });
    });

    const wranglerTools = Array.from(explorer.querySelectorAll('[data-wrangler-tool]'));
    wranglerTools.forEach((tool) => {
      tool.addEventListener('click', () => {
        wranglerTools.forEach((t) => t.classList.toggle('is-active', t === tool));
        const toolName = tool.getAttribute('data-wrangler-tool');
        showToast(`Applied ${toolName} transformation step`);
      });
    });

    // Wrangler Export Code Toggle
    const exportTabs = Array.from(explorer.querySelectorAll('[data-export-tab]'));
    const exportViews = Array.from(explorer.querySelectorAll('[data-export-view]'));
    exportTabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-export-tab');
        exportTabs.forEach((b) => b.classList.toggle('is-active', b === btn));
        exportViews.forEach((v) => {
          v.hidden = v.getAttribute('data-export-view') !== target;
        });
      });
    });
    explorer.querySelector('[data-wrangler-export]')?.addEventListener('click', () => {
      const exportBox = explorer.querySelector('.wrangler-export');
      if (exportBox) {
        exportBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        showToast('Exported cleaning recipe to Python LazyFrame & SQL');
      }
    });

    // Operator DAG Nodes in Analyze
    const opNodes = Array.from(explorer.querySelectorAll('[data-op-select]'));
    const opDetailText = explorer.querySelector('[data-op-detail]');
    const opDetails = {
      scan: 'ParquetScan: read s3://warehouse/tpch/lineitem.parquet across 16 threads (4 row groups, pushdown filter applied on l_shipdate).',
      filter: 'Filter: vectorized SIMD evaluation of predicate (l_shipdate <= \'1998-12-01\'), dropped 4.5M rows.',
      join: 'HashJoin: dynamic programming join ordering selected orders as build side (1.5M keys in memory pool, 0 B spilled).',
      agg: 'HashAggregate: vectorized hash grouping over 5 orderpriority groups in 5 ms.'
    };
    opNodes.forEach((node) => {
      node.addEventListener('click', () => {
        opNodes.forEach((n) => n.classList.toggle('op-node--active', n === node));
        const opKey = node.getAttribute('data-op-select');
        if (opDetailText && opDetails[opKey]) {
          opDetailText.textContent = opDetails[opKey];
        }
      });
    });

    // Scheduled Job DAG Tasks
    const dagTasks = Array.from(explorer.querySelectorAll('[data-dag-task]'));
    const dagCode = explorer.querySelector('[data-dag-code]');
    const dagSnippets = {
      load_raw: '[[task]]\nkey = "load_raw"\ntarget = "notebooks/load.py"\nmax_retries = 3\ntimeout_seconds = 300',
      transform_orders: '[[task]]\nkey = "transform_orders"\ntarget = "notebooks/enrich.py"\ndepends_on = ["load_raw"]\nrun_if = "all_success"',
      publish_report: '[[task]]\nkey = "publish_report"\ntarget = "queries/report.sql"\ndepends_on = ["transform_orders"]\nrun_if = "all_success"\nmax_retries = 2'
    };
    dagTasks.forEach((task) => {
      task.addEventListener('click', () => {
        dagTasks.forEach((t) => t.classList.toggle('dag-task--selected', t === task));
        const key = task.getAttribute('data-dag-task');
        if (dagCode && dagSnippets[key]) {
          dagCode.textContent = dagSnippets[key];
        }
      });
    });

    // Compute Cluster Action Buttons
    explorer.querySelector('[data-cluster-stream]')?.addEventListener('click', () => {
      const logs = explorer.querySelector('.cluster-card__log');
      if (logs) {
        const time = new Date().toLocaleTimeString();
        const line = document.createElement('code');
        line.textContent = `[${time}] worker-pool healthy · 16 threads active · 0 B spilled`;
        logs.appendChild(line);
        showToast('Streamed cluster telemetry heartbeat');
      }
    });
    explorer.querySelector('[data-cluster-ssh]')?.addEventListener('click', () => {
      showToast('Opening unprivileged SSH kernel tunnel on port 3870...');
    });
    explorer.querySelector('[data-cluster-pill]')?.addEventListener('click', () => {
      activateRailItem('compute');
    });

    // Git Actions
    explorer.querySelector('[data-git-commit]')?.addEventListener('click', () => {
      showToast('✓ Committed changes to branch main (marimo pure .py diff)');
    });

    // Pillar capability cards jumping
    const pillarCards = Array.from(document.querySelectorAll('[data-pillar-jump]'));
    pillarCards.forEach((card) => {
      card.addEventListener('click', () => {
        const target = card.getAttribute('data-pillar-jump');
        if (target) {
          activateRailItem(target);
          explorer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const target = card.getAttribute('data-pillar-jump');
          if (target) {
            activateRailItem(target);
            explorer.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Search / Command Palette
    const searchModal = explorer.querySelector('[data-search-modal]');
    const searchTrigger = explorer.querySelector('[data-search-trigger]');
    const searchInput = explorer.querySelector('[data-search-input]');
    const searchCloseButtons = Array.from(explorer.querySelectorAll('[data-search-close]'));
    const searchItems = Array.from(explorer.querySelectorAll('[data-search-target]'));

    function openSearch() {
      if (!searchModal) return;
      searchModal.hidden = false;
      searchModal.classList.add('is-open');
      searchModal.style.display = 'flex';
      const searchList = searchModal.querySelector('.search-modal__list');
      if (searchList) searchList.scrollTop = 0;
      if (searchInput) {
        searchInput.value = '';
        searchItems.forEach((item) => (item.hidden = false));
        setTimeout(() => searchInput.focus(), 30);
      }
    }

    function closeSearch() {
      if (!searchModal) return;
      searchModal.hidden = true;
      searchModal.classList.remove('is-open');
      searchModal.style.display = 'none';
    }

    searchTrigger?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      openSearch();
    });

    searchCloseButtons.forEach((b) => {
      b.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeSearch();
      });
    });

    // Explicit backdrop click listener
    const searchBackdrop = searchModal?.querySelector('.search-modal__backdrop');
    searchBackdrop?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeSearch();
    });

    document.addEventListener('keydown', (e) => {
      const isCmdK = (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k';
      const isEsc = e.key === 'Escape';
      const isOpen = searchModal && (!searchModal.hidden || searchModal.classList.contains('is-open') || searchModal.style.display === 'flex');

      if (isCmdK) {
        e.preventDefault();
        if (isOpen) {
          closeSearch();
        } else {
          openSearch();
        }
      } else if (isEsc && isOpen) {
        e.preventDefault();
        closeSearch();
      }
    });

    searchItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const target = item.getAttribute('data-search-target');
        closeSearch();
        if (target) activateRailItem(target);
      });
    });

    searchInput?.addEventListener('input', (e) => {
      const q = (e.target.value || '').toLowerCase().trim();
      searchItems.forEach((item) => {
        const txt = item.textContent?.toLowerCase() || '';
        item.hidden = q !== '' && !txt.includes(q);
      });
    });
  })();
</script>

