---
import LogoMark from './LogoMark.astro';

const tabs = [
  {
    id: 'notebook',
    label: 'Reactive Notebooks',
    badge: '.py · marimo',
    caption: 'Mix Python LazyFrames and SQL in one reactive graph. Plain .py files diff cleanly in Git.',
  },
  {
    id: 'wrangler',
    label: 'Data Wrangler',
    badge: '13 recipe steps',
    caption: 'Build visual cleaning recipes over all rows in the kernel and export clean DataFrame or SQL code.',
  },
  {
    id: 'analyze',
    label: 'Catalog & Analyze',
    badge: 'Delta · Profiler',
    caption: 'Browse multi-catalog schemas, time-travel Delta Lake commits, and inspect per-operator profiles.',
  },
  {
    id: 'jobs',
    label: 'Jobs & AWS Compute',
    badge: 'DAGs · EC2 Spot',
    caption: 'Schedule multi-task TOML pipelines on cron and spin up ephemeral EC2 Spot clusters over SSH.',
  },
];

const priorities = [
  { short: 'URGENT', name: '1-URGENT', count: '300,343', rev: '$42.8M', value: 300343 },
  { short: 'HIGH', name: '2-HIGH', count: '300,091', rev: '$42.6M', value: 300091 },
  { short: 'MEDIUM', name: '3-MEDIUM', count: '298,723', rev: '$42.1M', value: 298723 },
  { short: 'LOW', name: '4-NOT SPEC', count: '300,254', rev: '$42.5M', value: 300254 },
  { short: 'NONE', name: '5-LOW', count: '300,589', rev: '$42.9M', value: 300589 },
];
const maxPriority = Math.max(...priorities.map((p) => p.value));
const priorityCols = priorities.map((p) => ({
  ...p,
  pct: ((p.value / maxPriority) * 100).toFixed(1),
}));

const studioPillars = [
  {
    eyebrow: 'notebooks/*.py',
    title: 'Git-native marimo notebooks',
    text: 'Every cell is a pure Python function stored in a plain .py file. Run dependent cells automatically or mark them stale until triggered, with Jedi autocomplete and live SQL diagnostics.',
  },
  {
    eyebrow: 'Python ⇄ SQL',
    title: 'One shared namespace',
    text: 'Query any Python LazyFrame by variable name inside a SQL cell, and read any SQL cell result as a DataFrame in downstream Python cells. Named widgets bind directly to :param placeholders.',
  },
  {
    eyebrow: '/wrangle/<table>',
    title: 'Visual Data Wrangler',
    text: 'Filter, impute nulls, deduplicate, trim, regex replace, split, cast and one-hot encode. Steps compile into one kernel query with full-column histograms and export to Python or SQL.',
  },
  {
    eyebrow: '.iara/catalog.toml',
    title: 'Multi-catalog & Delta history',
    text: 'Mount local directories and s3:// buckets side by side, auto-discover schema folders, inspect Parquet statistics, and query or restore prior Delta Lake table commits.',
  },
  {
    eyebrow: '/analyze',
    title: 'Live profiles & spooled results',
    text: 'Page through results larger than RAM (spooled to disk above 128 MB), build kernel-aggregated charts, and open operator DAGs with row counts, timings and spilled bytes.',
  },
  {
    eyebrow: 'jobs/*.toml · EC2',
    title: 'Cron DAGs & AWS Spot clusters',
    text: 'Define multi-task DAGs with retries, parameter overrides and webhook alerts. Attach notebooks or jobs to on-demand or Spot EC2 clusters with custom pip libraries and time limits.',
  },
];

const railSections = [
  { name: 'Workspace', key: 'notebook' },
  { name: 'Data', key: 'analyze' },
  { name: 'Wrangler', key: 'wrangler' },
  { name: 'SQL', key: 'notebook' },
  { name: 'Analyze', key: 'analyze' },
  { name: 'Jobs', key: 'jobs' },
  { name: 'Compute', key: 'jobs' },
  { name: 'Git', key: 'notebook' },
];
---

<section class="section" id="studio">
  <div class="container">
    <div class="studio-head" data-reveal>
      <div>
        <span class="eyebrow">Iara Studio</span>
        <h2>A full analytics workspace, right on your files.</h2>
        <p class="lede">
          Iara Studio runs in the browser over a local folder or a shared S3 bucket. Notebooks stay plain <code>.py</code> files,
          queries stay <code>.sql</code> files, and jobs stay <code>.toml</code> files — so everything diffs and reviews in Git while
          queries execute in the Rust engine.
        </p>
      </div>

      <div class="studio-cli" aria-label="Launch Iara Studio from the terminal">
        <div class="studio-cli__top">
          <span class="studio-cli__label">Terminal</span>
          <span class="studio-cli__port">http://localhost:3870</span>
        </div>
        <pre class="studio-cli__code"><code><span class="prompt">$</span> iara serve examples/workspace</code></pre>
      </div>
    </div>

    <!-- Interactive Studio Workspace Explorer -->
    <div class="studio-explorer" data-reveal="scale" data-studio-explorer>
      <div class="studio-tabs" role="tablist" aria-label="Iara Studio views">
        {tabs.map((t, idx) => (
          <button
            type="button"
            role="tab"
            class={`studio-tab ${idx === 0 ? 'is-active' : ''}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`studio-panel-${t.id}`}
            id={`studio-tab-${t.id}`}
            data-studio-tab={t.id}
          >
            <span class="studio-tab__top">
              <span class="studio-tab__title">{t.label}</span>
              <span class="studio-tab__badge">{t.badge}</span>
            </span>
            <span class="studio-tab__desc">{t.caption}</span>
          </button>
        ))}
      </div>

      <div class="window">
        <!-- 48px Studio App Bar -->
        <div class="window__bar">
          <div class="window__brand">
            <LogoMark size={20} />
            <span class="window__name">Iara</span>
            <span class="window__path">/ tpch-demo</span>
          </div>
          <div class="window__search" aria-hidden="true">
            <span>Search notebooks, queries and tables</span>
            <kbd>Ctrl K</kbd>
          </div>
          <div class="window__meta" aria-hidden="true">
            <span class="cluster-pill">
              <span class="cluster-pill__dot"></span>
              m7i.4xlarge · 16 vCPUs
            </span>
          </div>
        </div>

        <div class="window__body">
          <!-- Left Navigation Rail -->
          <div class="rail" aria-hidden="true">
            {railSections.map((item, i) => (
              <div class={`rail__item ${i === 0 ? 'rail__item--active' : ''}`} data-rail-target={item.key} title={item.name}>
                <span class="rail__dot"></span>
                <span class="rail__label">{item.name}</span>
              </div>
            ))}
          </div>

          <!-- Panel 1: Reactive Notebooks -->
          <div
            class="studio-panel is-active"
            role="tabpanel"
            id="studio-panel-notebook"
            aria-labelledby="studio-tab-notebook"
            data-studio-panel="notebook"
          >
            <div class="notebook-layout">
              <div class="notebook-main">
                <!-- Tab strip & Widget bar -->
                <div class="workbench-strip">
                  <span class="tab-chip tab-chip--active">notebooks/revenue.py</span>
                  <span class="tab-chip">queries/regional_kpi.sql</span>
                  <span class="workbench-strip__right">Kernel · idle · 4 panes max</span>
                </div>

                <div class="widget-bar">
                  <span class="widget-bar__tag">Widgets</span>
                  <div class="widget-pill">
                    <span class="widget-pill__label">region</span>
                    <span class="widget-pill__val">AMERICA ▾</span>
                  </div>
                  <div class="widget-pill">
                    <span class="widget-pill__label">segment</span>
                    <span class="widget-pill__val">BUILDING ▾</span>
                  </div>
                  <div class="widget-pill">
                    <span class="widget-pill__label">min_acctbal</span>
                    <span class="widget-pill__val">1,000</span>
                  </div>
                </div>

                <!-- Cell 1: Python LazyFrame -->
                <div class="cell">
                  <div class="cell__head">
                    <span class="cell__lang">Python · cell_1</span>
                    <span class="cell__status">defined orders · 2 ms</span>
                  </div>
                  <pre class="code-line"><span class="kw">from</span> iara <span class="kw">import</span> functions <span class="kw">as</span> F
orders = ws.table(<span class="str">"orders"</span>).filter(F.col(<span class="str">"o_orderdate"</span>) &gt;= <span class="str">"1995-01-01"</span>)</pre>
                  <div class="frame-line">
                    <span class="frame-line__name">orders</span>
                    <span class="frame-line__kind">LazyFrame · 9 columns</span>
                    <span class="frame-line__cols">[o_orderkey: integer, o_custkey: integer, o_orderpriority: text, o_totalprice: decimal(15,2), …]</span>
                  </div>
                </div>

                <!-- Cell 2: SQL Cell sharing Python variable & widget parameter -->
                <div class="cell cell--active">
                  <div class="cell__head">
                    <span class="cell__lang cell__lang--sql">SQL · cell_2 → by_priority</span>
                    <span class="cell__status cell__status--ok">5 rows · 38 ms · 0 B spilled</span>
                  </div>
                  <pre class="code-line"><span class="kw">select</span> o_orderpriority, <span class="fn">count</span>(*) <span class="kw">as</span> orders, <span class="fn">sum</span>(o_totalprice) <span class="kw">as</span> revenue
<span class="kw">from</span> orders <span class="kw">where</span> o_mktsegment = <span class="num">:segment</span>
<span class="kw">group by</span> 1 <span class="kw">order by</span> 1</pre>

                  <div class="out-tabs">
                    <span class="out-tab out-tab--active">Table · 5 rows</span>
                    <span class="out-tab">Chart · Horizontal</span>
                    <span class="out-tab">Profile · 38 ms</span>
                    <span class="out-tab">Wrangle</span>
                  </div>

                  <div class="cell__out">
                    <table class="table">
                      <thead>
                        <tr>
                          <th scope="col">o_orderpriority <span class="th-type">text</span></th>
                          <th scope="col" class="num">orders <span class="th-type">integer</span></th>
                          <th scope="col" class="num">revenue <span class="th-type">decimal</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        {priorities.map((p) => (
                          <tr>
                            <td>{p.name}</td>
                            <td class="num">{p.count}</td>
                            <td class="num">{p.rev}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>

                    <!-- Horizontal Column Chart inside Studio output -->
                    <div class="studio-hchart" aria-label="Order counts by priority">
                      <div class="studio-hchart__title">Orders by priority (kernel-aggregated)</div>
                      <div class="studio-hchart__cols">
                        {priorityCols.map((c) => (
                          <div class="studio-hchart__col">
                            <div class="studio-hchart__track">
                              <span class="studio-hchart__bar hchart__col-bar" style={`height: ${c.pct}%`}></span>
                            </div>
                            <span class="studio-hchart__label">{c.short}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Side Panel: Outline & Variables -->
              <aside class="notebook-side" aria-hidden="true">
                <div class="side-block">
                  <div class="side-block__title">Variables (3)</div>
                  <div class="var-row">
                    <code>segment</code>
                    <span>"BUILDING"</span>
                  </div>
                  <div class="var-row">
                    <code>orders</code>
                    <span>LazyFrame · 9 cols</span>
                  </div>
                  <div class="var-row">
                    <code>by_priority</code>
                    <span>DataFrame · 5×3</span>
                  </div>
                </div>
                <div class="side-block">
                  <div class="side-block__title">Pipeline profile</div>
                  <div class="prof-row">
                    <span>Scan + Filter</span>
                    <span>14 ms</span>
                  </div>
                  <div class="prof-row">
                    <span>HashAggregate</span>
                    <span>24 ms</span>
                  </div>
                  <div class="prof-row prof-row--muted">
                    <span>Peak memory</span>
                    <span>94 MB / 8 GB</span>
                  </div>
                </div>
              </aside>
            </div>
          </div>

          <!-- Panel 2: Data Wrangler -->
          <div
            class="studio-panel"
            role="tabpanel"
            id="studio-panel-wrangler"
            aria-labelledby="studio-tab-wrangler"
            data-studio-panel="wrangler"
            hidden
          >
            <div class="wrangler-toolbar">
              <code class="wrangler-table-name">main.customer</code>
              <span class="wrangler-btn">Filter</span>
              <span class="wrangler-btn">Clean and impute</span>
              <span class="wrangler-btn">Text</span>
              <span class="wrangler-btn">Columns</span>
              <span class="wrangler-count">29,984 of 150,000 rows × 8 cols</span>
              <span class="wrangler-btn wrangler-btn--primary">Export code</span>
            </div>

            <div class="wrangler-layout">
              <div class="wrangler-steps">
                <div class="side-block__title">STEPS (4)</div>
                <div class="step-item">Source · main.customer</div>
                <div class="step-item">1. Filter c_mktsegment = "AUTOMOBILE"</div>
                <div class="step-item">2. Trim whitespace · c_name</div>
                <div class="step-item">3. Fill nulls · c_acctbal → 0.00</div>
                <div class="step-item step-item--active">4. Sort c_acctbal descending</div>
              </div>

              <div class="wrangler-main">
                <table class="table wrangler-grid">
                  <thead>
                    <tr>
                      <th>
                        <div>c_custkey <span class="th-type">integer</span></div>
                        <div class="qbar"><span style="width: 100%"></span></div>
                        <div class="qmeta">100% valid · 29.9k distinct</div>
                      </th>
                      <th>
                        <div>c_name <span class="th-type">text</span></div>
                        <div class="qbar"><span style="width: 100%"></span></div>
                        <div class="qmeta">trimmed · 0 nulls</div>
                      </th>
                      <th>
                        <div>c_nation <span class="th-type">text</span></div>
                        <div class="qbar"><span style="width: 98%"></span></div>
                        <div class="qmeta">25 distinct · top: US (14%)</div>
                      </th>
                      <th class="num">
                        <div>c_acctbal <span class="th-type">decimal(15,2)</span></div>
                        <div class="qbar"><span style="width: 100%"></span></div>
                        <div class="qmeta">min 0.00 · max 9,999.99</div>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="num">148201</td>
                      <td>Customer#000148201</td>
                      <td>UNITED STATES</td>
                      <td class="num">9,998.72</td>
                    </tr>
                    <tr>
                      <td class="num">91408</td>
                      <td>Customer#000091408</td>
                      <td>BRAZIL</td>
                      <td class="num">9,994.15</td>
                    </tr>
                    <tr>
                      <td class="num">32019</td>
                      <td>Customer#000032019</td>
                      <td>GERMANY</td>
                      <td class="num">9,991.40</td>
                    </tr>
                  </tbody>
                </table>

                <div class="wrangler-export">
                  <div class="wrangler-export__head">
                    <span>Exported Python DataFrame recipe</span>
                    <span>Runs over all rows in kernel</span>
                  </div>
                  <pre class="code-line"><span class="kw">from</span> iara <span class="kw">import</span> functions <span class="kw">as</span> F
wrangled = (
    ws.table(<span class="str">"customer"</span>)
    .filter(F.col(<span class="str">"c_mktsegment"</span>) == <span class="str">"AUTOMOBILE"</span>)
    .with_columns(c_name=F.col(<span class="str">"c_name"</span>).str.strip_chars(), c_acctbal=F.col(<span class="str">"c_acctbal"</span>).fill_null(<span class="num">0.0</span>))
    .sort(<span class="str">"c_acctbal"</span>, descending=<span class="kw">True</span>)
)</pre>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 3: Catalog & Query Analyzer -->
          <div
            class="studio-panel"
            role="tabpanel"
            id="studio-panel-analyze"
            aria-labelledby="studio-tab-analyze"
            data-studio-panel="analyze"
            hidden
          >
            <div class="analyze-layout">
              <div class="catalog-pane">
                <div class="side-block__title">Catalogs &amp; Delta History</div>
                <div class="catalog-tree">
                  <div class="catalog-node catalog-node--root">▾ tpch (default)</div>
                  <div class="catalog-node catalog-node--schema">▾ main · s3://warehouse/tpch</div>
                  <div class="catalog-node catalog-node--table is-selected">orders · Delta · 1.5M rows</div>
                  <div class="catalog-node catalog-node--table">lineitem · Parquet · 6.0M rows</div>
                  <div class="catalog-node catalog-node--table">customer · Parquet · 150k rows</div>
                  <div class="catalog-node catalog-node--root">▸ sales · s3://bucket/sales</div>
                </div>

                <div class="delta-commits">
                  <div class="side-block__title">Delta History · main.orders</div>
                  <div class="commit-row">
                    <span class="commit-ver">v18</span>
                    <span class="commit-op">MERGE INTO · +14,200 rows</span>
                    <span class="commit-act">Current</span>
                  </div>
                  <div class="commit-row">
                    <span class="commit-ver">v17</span>
                    <span class="commit-op">DELETE WHERE status = 'X'</span>
                    <span class="commit-act commit-act--link">Restore</span>
                  </div>
                  <div class="commit-row">
                    <span class="commit-ver">v16</span>
                    <span class="commit-op">CREATE TABLE AS SELECT</span>
                    <span class="commit-act commit-act--link">Query @v16</span>
                  </div>
                </div>
              </div>

              <div class="analyze-main">
                <div class="analyze-header">
                  <div>
                    <span class="side-block__title">Query Analyze · /analyze/9f3a8c12</span>
                    <div class="analyze-title">Pipeline timeline &amp; operator graph (16 cores)</div>
                  </div>
                  <span class="cell__status cell__status--ok">43 ms total · 412 MB peak · 0 B spilled</span>
                </div>

                <!-- Horizontal Operator Timeline -->
                <div class="op-bars">
                  <div class="op-row">
                    <span class="op-name">1. ParquetScan (lineitem)</span>
                    <div class="op-track">
                      <span class="op-fill" style="width: 33%"></span>
                    </div>
                    <span class="op-stat">6.0M rows · 14 ms</span>
                  </div>
                  <div class="op-row">
                    <span class="op-name">2. Filter (l_shipdate)</span>
                    <div class="op-track">
                      <span class="op-fill" style="left: 25%; width: 12%"></span>
                    </div>
                    <span class="op-stat">1.5M rows · 5 ms</span>
                  </div>
                  <div class="op-row">
                    <span class="op-name">3. HashJoin (build: orders)</span>
                    <div class="op-track">
                      <span class="op-fill op-fill--cobalt" style="left: 34%; width: 44%"></span>
                    </div>
                    <span class="op-stat">1.5M rows · 19 ms</span>
                  </div>
                  <div class="op-row">
                    <span class="op-name">4. HashAggregate (group by)</span>
                    <div class="op-track">
                      <span class="op-fill" style="left: 78%; width: 22%"></span>
                    </div>
                    <span class="op-stat">5 rows · 5 ms</span>
                  </div>
                </div>

                <div class="op-dag">
                  <span class="op-node">ParquetScan · 6.0M</span>
                  <span class="op-arrow">→</span>
                  <span class="op-node">Filter · 1.5M</span>
                  <span class="op-arrow">→</span>
                  <span class="op-node op-node--active">HashJoin (DP ordered) · 1.5M</span>
                  <span class="op-arrow">→</span>
                  <span class="op-node">HashAggregate · 5</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 4: Jobs & AWS Compute -->
          <div
            class="studio-panel"
            role="tabpanel"
            id="studio-panel-jobs"
            aria-labelledby="studio-tab-jobs"
            data-studio-panel="jobs"
            hidden
          >
            <div class="jobs-layout">
              <div class="jobs-pane">
                <div class="analyze-header">
                  <div>
                    <span class="side-block__title">Scheduled Job · jobs/nightly_sales.toml</span>
                    <div class="analyze-title">Nightly sales mart · <code>0 6 * * *</code> UTC</div>
                  </div>
                  <span class="cell__status cell__status--ok">Run #48 · all_success · 14.2 s</span>
                </div>

                <!-- Horizontal Task DAG -->
                <div class="dag-flow">
                  <div class="dag-task dag-task--ok">
                    <span class="dag-task__status">✓ 4.1 s</span>
                    <strong>load_raw</strong>
                    <span>notebooks/load.py</span>
                  </div>
                  <span class="op-arrow">→</span>
                  <div class="dag-task dag-task--ok">
                    <span class="dag-task__status">✓ 6.8 s</span>
                    <strong>transform_orders</strong>
                    <span>notebooks/enrich.py</span>
                  </div>
                  <span class="op-arrow">→</span>
                  <div class="dag-task dag-task--ok">
                    <span class="dag-task__status">✓ 3.3 s</span>
                    <strong>publish_report</strong>
                    <span>queries/report.sql</span>
                  </div>
                </div>

                <pre class="code-line">name = <span class="str">"Nightly sales"</span>
schedule = <span class="str">"0 6 * * *"</span>
cluster = <span class="str">"job"</span>

[[task]]
key = <span class="str">"publish_report"</span>
target = <span class="str">"queries/report.sql"</span>
depends_on = [<span class="str">"transform_orders"</span>]
run_if = <span class="str">"all_success"</span>
max_retries = <span class="num">2</span></pre>
              </div>

              <div class="compute-pane">
                <div class="side-block__title">AWS EC2 Compute Clusters</div>
                <div class="cluster-card">
                  <div class="cluster-card__head">
                    <strong>analytics-xl</strong>
                    <span class="cluster-badge cluster-badge--spot">spot · default</span>
                    <span class="cluster-badge cluster-badge--run">running</span>
                  </div>
                  <div class="cluster-card__specs">
                    <span>m7i.4xlarge · 16 vCPUs · 64 GB RAM</span>
                    <span>Limit: 2 h · terminates at 23:00</span>
                    <span>Libraries: polars, rich==13.9.4, pyarrow</span>
                  </div>
                  <div class="cluster-card__log">
                    <code>[boot] ssh kernel tunnel ready (unprivileged user)</code>
                    <code>[pip] 3 libraries installed in 4.2s</code>
                    <code>[kernel] iara-core 0.1.0 initialized (16 threads)</code>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 6 Expanded Studio Capability Cards -->
    <div class="grid grid--3 studio-pillars" data-reveal-stagger>
      {studioPillars.map((p) => (
        <article class="card pillar-card">
          <span class="pillar-card__eyebrow">{p.eyebrow}</span>
          <h3>{p.title}</h3>
          <p class="muted small">{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const explorer = document.querySelector('[data-studio-explorer]');
    if (!explorer) return;
    const tabButtons = Array.from(explorer.querySelectorAll('[data-studio-tab]'));
    const panels = Array.from(explorer.querySelectorAll('[data-studio-panel]'));
    const railItems = Array.from(explorer.querySelectorAll('[data-rail-target]'));

    function activateTab(id) {
      tabButtons.forEach((btn) => {
        const active = btn.getAttribute('data-studio-tab') === id;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const active = panel.getAttribute('data-studio-panel') === id;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
      let highlighted = false;
      railItems.forEach((item) => {
        const match = !highlighted && item.getAttribute('data-rail-target') === id;
        if (match) highlighted = true;
        item.classList.toggle('rail__item--active', match);
      });
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-studio-tab');
        if (id) activateTab(id);
      });
    });

    railItems.forEach((item) => {
      item.addEventListener('click', () => {
        const id = item.getAttribute('data-rail-target');
        if (id) activateTab(id);
      });
    });
  })();
</script>

