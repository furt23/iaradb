---
import LogoMark from './LogoMark.astro';
import { DOCS_URL } from '../config';
import { suites, summary } from '../data/bench';

const quickstartUrl = `${DOCS_URL}/quickstart/`;
// Iara's sum over all queries, and the fastest other engine that ran them all
const stats = (
  [
    ['tpch_sf10', 'TPC-H SF10'],
    ['tpch_sf100', 'TPC-H SF100'],
    ['clickbench', 'ClickBench'],
  ] as const
)
  .filter(([key]) => suites[key])
  .map(([key, title]) => {
    const sum = summary(suites[key]);
    const iara = sum.engines.find((e) => e.key === 'iara')!;
    const next = sum.engines.filter((e) => e.key !== 'iara' && e.sumS != null).sort((a, b) => a.sumS! - b.sumS!)[0];
    const f = (v: number) => `${v.toFixed(v < 10 ? 2 : 1)} s`;
    return { value: f(iara.sumS!), label: `${title}, all ${sum.of} queries`, next: `${next.name} ${f(next.sumS!)}` };
  });
const engineCount = suites.tpch_sf10?.engines.length ?? 0;
---

<section class="section hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">Query engine · Rust · Apache Arrow</p>
      <h1>Analytics on one machine, on every core.</h1>
      <p class="lede">Iara is a parallel query engine written in Rust on Apache Arrow. Query Parquet, CSV, JSON and Delta Lake tables from Python, with a lazy DataFrame API or SQL.</p>

      <div class="hero__actions">
        <a class="button button--primary" href={quickstartUrl}>Get started</a>
        <a class="button button--ghost" href="/benchmarks/">See the benchmarks</a>
      </div>

      <div class="stats" data-reveal-stagger>
        {stats.map((s) => (
          <div class="stat">
            <span class="stat__value">{s.value}</span>
            <span class="small muted">{s.label}</span>
          </div>
        ))}
      </div>
      <p class="small muted stats__note">16 vCPUs, 64 GB RAM, {engineCount} engines. Fastest other engine: {stats.map((s) => s.next).join(', ')}.</p>
    </div>

    <div class="hero__visual">
      <div class="hero__mark" aria-hidden="true">
        <LogoMark size={420} />
      </div>

      <div class="window">
        <div class="window__bar">
          <span class="window__dot window__dot--1"></span>
          <span class="window__dot window__dot--2"></span>
          <span class="window__dot window__dot--3"></span>
          <span class="window__name">revenue.py</span>
          <span class="window__badge">LazyFrame → Arrow</span>
        </div>
        <pre class="code"><span class="kw">import</span> iara
<span class="kw">from</span> iara <span class="kw">import</span> functions <span class="kw">as</span> F

revenue = (
    iara.<span class="fn">scan_parquet</span>(<span class="str">"data/lineitem"</span>)
    .<span class="fn">join</span>(iara.<span class="fn">scan_parquet</span>(<span class="str">"data/orders"</span>),
          <span class="fn">left_on</span>=<span class="str">"l_orderkey"</span>, <span class="fn">right_on</span>=<span class="str">"o_orderkey"</span>)
    .<span class="fn">group_by</span>(<span class="str">"o_orderpriority"</span>)
    .<span class="fn">agg</span>(revenue=(F.<span class="fn">col</span>(<span class="str">"l_extendedprice"</span>)
                  * (<span class="num">1</span> - F.<span class="fn">col</span>(<span class="str">"l_discount"</span>))).<span class="fn">sum</span>())
    .<span class="fn">sort</span>(<span class="str">"revenue"</span>, descending=<span class="kw">True</span>)
    .<span class="fn">collect</span>()
)</pre>
        <div class="window__foot" aria-hidden="true">
          <span class="window__status">
            <span class="window__pulse"></span>
            5 rows · 42 ms
          </span>
          <span class="window__cores" title="16 worker threads active">
            {Array.from({ length: 16 }).map((_, i) => (
              <span class="window__core" style={`--core-i: ${i}`} />
            ))}
            <span class="window__cores-label">16 cores</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero__text,
  .hero__visual {
    min-width: 0;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__text {
      animation: hero-enter 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero__visual {
      animation: hero-enter 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat__value {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 560;
    line-height: 1.1;
    color: var(--cobalt);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .stats__note {
    margin-top: 16px;
    margin-bottom: 0;
  }

  @keyframes mark-float {
    0%, 100% {
      transform: translateY(-50%) rotate(0deg) scale(1);
    }
    50% {
      transform: translateY(-53%) rotate(1.5deg) scale(1.03);
    }
  }

  /* decorative mark behind the code window; clipped by .hero so it never scrolls the page */
  .hero__mark {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: -120px;
    transform: translateY(-50%);
    opacity: 0.08;
    pointer-events: none;
    animation: mark-float 10s ease-in-out infinite;
    --animation-reduced: none;
  }

  .hero__visual {
    position: relative;
  }

  .window {
    position: relative;
    background: var(--night);
    border: 1px solid var(--night-rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 52px rgba(14, 26, 43, 0.24);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
  }

  .window:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 60px rgba(14, 26, 43, 0.3);
  }

  .window__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    background: rgba(21, 36, 58, 0.65);
    border-bottom: 1px solid var(--night-rule);
  }

  .window__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--night-rule);
  }

  .window__dot--1 { background: #3b4f6b; }
  .window__dot--2 { background: #2e5d99; }
  .window__dot--3 { background: var(--azure); }

  .window__name {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--night-ink);
  }

  .window__badge {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--sky);
    background: rgba(74, 143, 224, 0.14);
    border: 1px solid rgba(127, 178, 240, 0.24);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .window pre.code {
    border-radius: 0;
    font-size: 0.8rem;
  }

  .window__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 16px;
    background: var(--night-2);
    border-top: 1px solid var(--night-rule);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--night-dim);
  }

  .window__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--night-ink);
  }

  @keyframes status-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  .window__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #5ad48c;
    box-shadow: 0 0 8px rgba(90, 212, 140, 0.6);
    animation: status-pulse 2.4s ease-in-out infinite;
    --animation-reduced: none;
  }

  .window__cores {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
  }

  @keyframes core-wave {
    0%, 100% {
      transform: scaleY(0.55);
      opacity: 0.65;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .window__core {
    width: 3px;
    height: 11px;
    border-radius: 1px;
    background: var(--sky);
    transform-origin: center bottom;
    animation: core-wave 1.8s ease-in-out infinite;
    animation-delay: calc(var(--core-i) * 90ms);
    --animation-reduced: none;
  }

  .window__cores-label {
    margin-left: 6px;
    font-size: 0.72rem;
    color: var(--night-dim);
  }

  @media (max-width: 899px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }

  @media (max-width: 480px) {
    .window pre.code {
      padding: 18px 16px;
      font-size: 0.74rem;
    }

    .window__badge {
      display: none;
    }

    .hero__mark {
      right: -180px;
    }
  }
</style>

