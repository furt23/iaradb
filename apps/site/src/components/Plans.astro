---
/** The self-hosted strip and the five plan cards; used on the home page and on /pricing/. */
import { plans } from '../data/pricing';
---

<div class="oss" data-reveal>
  <div>
    <b>Self-hosted</b> · engine and Studio on your own infrastructure<br />
    <span>No usage limits. Community support.</span>
  </div>
  <span class="pill">$0 · Apache-2.0</span>
</div>

<div class="plans" data-reveal-stagger>
  {plans.map((p) => (
    <article class:list={['plan', { 'plan--hl': p.tag }]}>
      {p.tag && <span class="plan__tag">{p.tag}</span>}
      <span class="plan__name">{p.name}</span>
      <div class:list={['plan__price', { 'plan__price--text': !p.price.startsWith('$') }]}>
        {p.price}<small>{p.unit ?? ' '}</small>
      </div>
      <div class="plan__per">{p.per}</div>
      <dl>
        {p.stats.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
      <p class="plan__who">{p.who}</p>
    </article>
  ))}
</div>

<p class="small muted plans__note" data-reveal>Prices in US dollars. Compute, storage and Iara quotas reset monthly. Viewers can open dashboards but not edit. Annual billing gives two months free.</p>

<style>
  .oss {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    background: var(--vellum);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-lg);
    padding: 20px 28px;
    margin-bottom: 28px;
  }

  .oss b {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 560;
  }

  .oss span {
    color: var(--ink-2);
  }

  .pill {
    font: 500 0.78rem var(--font-mono);
    background: var(--mist-2);
    color: var(--cobalt) !important;
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--vellum);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 26px 20px 22px;
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .plan:hover {
    transform: translateY(-3px);
    border-color: var(--rule-strong);
    box-shadow: 0 2px 0 rgba(29, 42, 54, 0.05), 0 16px 36px rgba(29, 42, 54, 0.09);
  }

  .plan--hl,
  .plan--hl:hover {
    border: 2px solid var(--cobalt);
    box-shadow: 0 10px 32px rgba(30, 91, 184, 0.16);
  }

  .plan__tag {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--cobalt);
    color: #fff;
    font: 500 0.7rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .plan__name {
    font: 500 0.78rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .plan__price {
    font: 560 2.6rem/1 var(--font-display);
    letter-spacing: -0.02em;
    margin: 14px 0 6px;
  }

  .plan__price small {
    display: block;
    margin-top: 6px;
    font: 500 0.85rem var(--font-sans);
    color: var(--ink-2);
    letter-spacing: 0;
  }

  /* same height as a $ price so every card's list starts on the same line */
  .plan__price--text {
    font-size: 2rem;
    line-height: 1.3;
  }

  .plan__per {
    color: var(--ink-3);
    font-size: 0.82rem;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
  }

  dl {
    margin: 12px 0 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 5px 0;
    font-size: 0.88rem;
  }

  dt {
    color: var(--ink-2);
  }

  dd {
    margin: 0;
    font-weight: 600;
    white-space: nowrap;
    text-align: right;
  }

  .plan__who {
    margin: auto 0 0;
    padding-top: 16px;
    font-size: 0.84rem;
    color: var(--ink-2);
  }

  .plans__note {
    margin: 20px 0 0;
  }

  @media (max-width: 1080px) {
    .plans {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }

    .oss {
      padding: 18px 20px;
    }
  }
</style>
