---
import BenchBars from './BenchBars.astro';
import { suites, names, summary } from '../data/bench';

const cards = (
  [
    ['tpch_sf10', 'TPC-H SF10'],
    ['tpch_sf100', 'TPC-H SF100'],
    ['clickbench', 'ClickBench'],
  ] as const
)
  .filter(([key]) => suites[key])
  .map(([key, title]) => {
    const sum = summary(suites[key]);
    const ranked = sum.engines.filter((e) => e.sumS != null).sort((a, b) => a.sumS! - b.sumS!);
    const iara = ranked.find((e) => e.key === 'iara')!;
    const rank = ranked.indexOf(iara);
    const next = ranked[rank === 0 ? 1 : 0];
    const badge = rank === 0 ? `${(next.sumS! / iara.sumS!).toFixed(2)}× vs ${next.name}` : `#${rank + 1} of ${ranked.length}`;
    return {
      title,
      badge,
      label: `sum of all ${sum.of} queries`,
      engines: sum.engines.map((e) => e.key),
      values: Object.fromEntries(sum.engines.map((e) => [e.key, e.sumS])),
      notes: Object.fromEntries(sum.engines.filter((e) => e.sumS == null).map((e) => [e.key, `ran ${e.ran} of ${sum.of}`])),
    };
  });
const others = (suites.tpch_sf10?.engines ?? []).filter((e) => e !== 'iara').map((e) => names[e]);
---

<section class="section section--alt" id="benchmarks">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Benchmarks</span>
      <h2>Measured against {others.length} other engines.</h2>
      <p class="lede">TPC-H and ClickBench on the same Parquet files in Iara, {others.slice(0, -1).join(', ')} and {others[others.length - 1]}, on an AWS m7i.4xlarge with 16 vCPUs and 64 GB of RAM. Lower is better.</p>
    </div>

    <div class="grid grid--3" data-reveal-stagger>
      {cards.map((c) => (
        <div class="card bench-card">
          <div class="bench-card__head">
            <h3>{c.title}</h3>
            <span class="bench-card__badge">{c.badge}</span>
          </div>
          <BenchBars title={c.title} unit="s" engines={c.engines} names={names} rows={[{ label: c.label, values: c.values, notes: c.notes }]} />
        </div>
      ))}
    </div>

    <div class="bench-more" data-reveal>
      <a class="button button--ghost" href="/benchmarks/">Explore the per-query results →</a>
    </div>
  </div>
</section>

<style>
  .bench-card {
    min-width: 0;
  }

  .bench-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  .bench-card h3 {
    font-size: 1.1rem;
    margin: 0;
  }

  .bench-card__badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--cobalt);
    background: var(--mist-2);
    border: 1px solid var(--mist);
    padding: 2px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .bench-more {
    margin-top: 40px;
  }
</style>

