---
import Base from '../layouts/Base.astro';
import BenchBars from '../components/BenchBars.astro';
import { GITHUB_URL } from '../config';
import { suites, names, summary, chartRows, ok, realistic } from '../data/bench';

const panels = [
  { key: 'tpch_sf100', tab: 'TPC-H SF100', title: 'TPC-H SF100 (100 GB)', capMax: undefined },
  { key: 'tpch_sf10', tab: 'TPC-H SF10', title: 'TPC-H SF10 (10 GB)', capMax: undefined },
  { key: 'clickbench', tab: 'ClickBench', title: 'ClickBench (hits, 100M rows)', capMax: undefined },
] as const;

const available = panels.filter((p) => suites[p.key]);
const engines = suites.tpch_sf10?.engines ?? Object.keys(names);
const versions = suites.tpch_sf10?.meta.versions ?? {};
const others = engines.filter((e) => e !== 'iara');
const engineList = others.map((e) => `${names[e]} ${versions[e] ?? ''}`.trim());

const cell = (q: { ms: Record<string, number | null>; notes: Record<string, string> }, e: string) => {
  const v = q.ms[e];
  if (v == null) return q.notes[e]?.startsWith('timeout') ? 'timeout' : 'n/a';
  return Math.round(v).toLocaleString('en-US') + (q.notes[e] ? ' †' : '');
};
const bestOf = (q: { ms: Record<string, number | null>; notes: Record<string, string> }, es: string[]) =>
  Math.min(...es.filter((e) => ok(q as never, e)).map((e) => q.ms[e] as number));

const realEngines = realistic.length ? Object.keys(realistic[0]).filter((k) => k !== 'name') : [];
const pretty = (w: string) => w.replace(/_/g, ' ');
---

<Base title="Benchmarks · Iara" description={`TPC-H and ClickBench results for Iara, ${engineList.map((s) => s.split(' ')[0]).join(', ')}.`}>
  <section class="section">
    <div class="container page">
      <header class="page-head" data-reveal>
        <span class="eyebrow">Benchmarks</span>
        <h1>Benchmarks</h1>
        <p class="lede">
          TPC-H (all 22 queries, SF10 and SF100) and ClickBench (43 queries) on the same Parquet files, in Iara,
          {' '}{engineList.slice(0, -1).join(', ')} and {engineList[engineList.length - 1]}. Every engine runs from Python
          with its default settings, in its own process, on an AWS m7i.4xlarge (16 vCPUs, Xeon 8488C, 64 GB RAM) on
          Amazon Linux 2023. Spark runs in local mode with 75% of the RAM for the driver.
        </p>
        <p class="muted">
          Each figure is the median of 3 runs after a warm-up run (one run when the warm-up takes over 30 s). A query that
          fails or runs past the time limit (10 min at SF10 and ClickBench, 15 min at SF100) shows as n/a or timeout.
          TPC-H results are compared with DuckDB's; a dagger (†) marks a result that differs. Measured {suites.tpch_sf10?.meta.date}; Iara re-measured on the same instance type after later engine changes, the other engines kept from the first run.
        </p>
      </header>

      <div class="section-split" data-reveal>
        <h2 data-suite-heading>{available[0]?.title}</h2>
        <div class="sf-tabs" role="tablist" aria-label="Benchmark">
          {available.map((p, i) => (
            <button type="button" role="tab" class={`sf-tab ${i === 0 ? 'is-active' : ''}`} aria-selected={i === 0 ? 'true' : 'false'} data-sf-tab={p.key} data-title={p.title}>
              {p.tab}
            </button>
          ))}
        </div>
      </div>

      {available.map((p, i) => {
        const s = suites[p.key];
        const sum = summary(s);
        const half = Math.ceil(s.queries.length / 2);
        return (
          <div data-sf-panel={p.key} hidden={i !== 0}>
            <div class="table-wrap" data-reveal>
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Engine</th>
                    <th scope="col" class="num">Correct results</th>
                    <th scope="col" class="num">Sum, all {sum.of}</th>
                    <th scope="col" class="num">Geometric mean</th>
                    <th scope="col" class="num">Iara faster by</th>
                  </tr>
                </thead>
                <tbody>
                  {sum.engines.map((e) => {
                    const bestSum = Math.min(...sum.engines.map((x) => x.sumS ?? Infinity));
                    return (
                      <tr>
                        <th scope="row">
                          {e.name} <span class="muted small">{e.version}</span>
                        </th>
                        <td class="num">{e.completed} / {sum.of}</td>
                        <td class={`num ${e.sumS === bestSum ? 'cell-best' : ''} ${e.sumS == null ? 'cell-na' : ''}`}>
                          {e.sumS == null ? `${sum.of - e.ran} failed` : `${e.sumS.toFixed(e.sumS < 10 ? 2 : 1)} s${e.wrong ? ' †' : ''}`}
                        </td>
                        <td class={`num ${e.geomeanMs == null ? 'cell-na' : ''}`}>
                          {e.geomeanMs == null ? '' : e.geomeanMs < 10000 ? `${Math.round(e.geomeanMs)} ms` : `${(e.geomeanMs / 1000).toFixed(1)} s`}
                        </td>
                        <td class="num">{e.key === 'iara' ? '' : `${e.vsIara.toFixed(2)}×`}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <p class="muted small table-note">
              Sums and geometric means cover all {sum.of} queries, so they are left out for an engine that failed one;
              † marks a sum that includes a wrong result. "Iara faster by" is the geometric mean of the per-query time
              ratios over the queries both engines ran correctly (below 1×, the other engine is faster).
            </p>

            <div class="chart" data-reveal="scale">
              <BenchBars title={`${p.title}, per query`} unit="ms" engines={s.engines} names={names} rows={chartRows(s)} capMax={p.capMax} />
            </div>

            <div class="query-matrix" data-reveal>
              <div class="table-wrap">
                <table class="table table--compact">
                  <thead>
                    <tr>
                      <th scope="col">Query (ms)</th>
                      {s.engines.map((e) => <th scope="col" class="num">{names[e]}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {s.queries.map((q) => {
                      const best = bestOf(q, s.engines);
                      return (
                        <tr>
                          <th scope="row">{q.label}</th>
                          {s.engines.map((e) => (
                            <td class={`num ${ok(q, e) && q.ms[e] === best ? 'cell-best' : ''} ${q.ms[e] == null ? 'cell-na' : ''}`} title={q.notes[e] ?? ''}>
                              {cell(q, e)}
                            </td>
                          ))}
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        );
      })}

      {realistic.length > 0 && (
        <>
          <h2 data-reveal>DataFrame workloads</h2>
          <p class="muted" data-reveal>
            Nineteen everyday DataFrame jobs (reading CSV and JSON, writing Parquet, window functions, string work, an
            eager notebook session) on TPC-H SF100 tables and ClickBench, written once against the Polars-style API that
            Iara shares with Polars; Polars uses its streaming engine. Each job runs in a fresh process, best of two
            runs, with the peak private memory of the process.
          </p>
          <div class="table-wrap" data-reveal>
            <table class="table table--compact">
              <thead>
                <tr>
                  <th scope="col">Workload</th>
                  {realEngines.map((e) => (
                    <>
                      <th scope="col" class="num">{names[e]} (s)</th>
                      <th scope="col" class="num">{names[e]} (MB)</th>
                    </>
                  ))}
                </tr>
              </thead>
              <tbody>
                {realistic.map((r) => {
                  const times = realEngines.map((e) => (r[e] as { s: number } | null)?.s ?? Infinity);
                  const best = Math.min(...times);
                  return (
                    <tr>
                      <th scope="row">{pretty(r.name)}</th>
                      {realEngines.map((e) => {
                        const v = r[e] as { s: number; mb: number } | null;
                        return v ? (
                          <>
                            <td class={`num ${v.s === best ? 'cell-best' : ''}`}>{v.s.toFixed(2)}</td>
                            <td class="num">{v.mb.toLocaleString('en-US')}</td>
                          </>
                        ) : (
                          <>
                            <td class="num cell-na">failed</td>
                            <td class="num cell-na" />
                          </>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </>
      )}

      <div class="grid grid--2 bottom-notes" data-reveal-stagger>
        <div class="card">
          <h2>Notes</h2>
          <ul class="notes muted">
            <li>
              Where Iara is slower: TPC-H Q2 against Polars (1.4× at SF100); in ClickBench, grouped
              <code>COUNT(DISTINCT ...)</code> (Q8, Q9: 1.6-1.8× DuckDB), wide <code>GROUP BY</code>s (Q16-Q18, Q32: 1.5-2.5×) and
              <code>REGEXP_REPLACE</code> (Q28: 2.9 s against chDB's 1.6 s).
            </li>
            <li>
              chDB and Daft return a wrong sum for TPC-H Q6: they evaluate <code>between 0.06 - 0.01 and 0.06 + 0.01</code>
              in floating point, which drops the rows with a 0.07 discount. Polars and chDB round Q8's ratio to the
              <code>DECIMAL</code> scale (0.04, 0.0395); those count as correct.
            </li>
            <li>
              Daft cannot plan TPC-H Q1, Q8, Q9 and Q14 (in Q1 the <code>DECIMAL</code> product exceeds 38 digits) or the
              correlated subquery in Q21, and ran out of memory on ClickBench Q23. Polars SQL has no
              <code>regexp_replace</code> or <code>date_trunc</code> and rejects Q35's repeated group key.
            </li>
            <li>
              ClickBench reads a copy of hits.parquet with <code>EventTime</code> as a timestamp, <code>EventDate</code> as a
              date and strings as UTF-8 (<code>prepare_hits.py</code>). DuckDB runs with its Parquet metadata cache on.
            </li>
          </ul>
        </div>

        <div class="card">
          <h2>Reproduce</h2>
          <p class="muted">
            The scripts and query definitions are in the <a href={`${GITHUB_URL}/tree/master/benchmarks`}>benchmarks/ folder</a> of the repository.
          </p>
          <pre class="code-mini">python benchmarks/bench_tpch.py data/sf100 --validate --json sf100.json
python benchmarks/prepare_hits.py hits.parquet hits_typed.parquet
python benchmarks/bench_clickbench.py hits_typed.parquet</pre>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const btns = Array.from(document.querySelectorAll('[data-sf-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-sf-panel]'));
    const heading = document.querySelector('[data-suite-heading]');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-sf-tab');
        btns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-sf-panel') !== target;
        });
        if (heading) heading.textContent = btn.getAttribute('data-title');
      });
    });
  })();
</script>

<style>
  .page-head {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .page h2 {
    margin: 72px 0 24px;
  }

  .section-split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin: 72px 0 24px;
  }

  .section-split h2 {
    margin: 0;
  }

  .sf-tabs {
    display: inline-flex;
    background: var(--parchment-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }

  .sf-tab {
    appearance: none;
    border: none;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-2);
    padding: 6px 14px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sf-tab.is-active {
    background: var(--vellum);
    color: var(--cobalt);
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(29, 42, 54, 0.08);
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--vellum);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .table {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .table th,
  .table td {
    padding: 12px 18px;
    text-align: left;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }

  .table--compact {
    font-size: 0.84rem;
    min-width: 640px;
  }

  .table--compact th,
  .table--compact td {
    padding: 8px 14px;
  }

  .col-sep {
    border-left: 1px solid var(--rule);
  }

  .cell-na {
    color: var(--ink-3);
  }

  .table-note {
    margin: 10px 0 40px;
  }

  .cell-best {
    font-weight: 700;
    color: var(--cobalt);
  }

  .table tbody tr:last-child th,
  .table tbody tr:last-child td {
    border-bottom: none;
  }

  .table thead th {
    color: var(--ink-2);
    font-weight: 600;
  }

  .table tbody th {
    font-weight: 500;
    color: var(--ink);
  }

  .num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .chart {
    width: 100%;
    margin-bottom: 20px;
  }

  .query-matrix {
    margin-bottom: 16px;
  }

  .bottom-notes {
    margin-top: 64px;
  }

  .bottom-notes h2 {
    margin: 0 0 12px;
    font-size: 1.5rem;
  }

  .bottom-notes p:last-child {
    margin-bottom: 0;
  }

  .notes {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 10px;
    font-size: 0.92rem;
  }

  .code-mini {
    margin: 14px 0 0;
    padding: 10px 14px;
    background: var(--night);
    color: var(--night-ink);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    overflow-x: auto;
  }
</style>
