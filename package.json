{
  "name": "iara-studio",
  "private": true,
  "description": "Iara Studio: a workspace for the Iara engine (notebooks, catalog, SQL, Git)",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --filter @iara/web dev",
    "build": "pnpm --filter @iara/web build",
    "start": "pnpm --filter @iara/web start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @iara/web e2e"
  }
}
