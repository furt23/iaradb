# Copy to config.yml (gitignored) in this folder, next to the tunnel's <TUNNEL_ID>.json.
# Made with: cloudflared tunnel login; cloudflared tunnel create workhouse
tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

ingress:
  - hostname: workhouse.dev
    service: http://site:8080
  - hostname: docs.workhouse.dev
    service: http://docs:8080
  - hostname: studio-default.workhouse.dev
    service: http://studio-default:3870
  # optional view-only hostname (IARA_VIEW_HOST): the same Studio service. Do not set httpHostHeader:
  # the Studio tells the two hostnames apart by the Host header.
  - hostname: view-default.workhouse.dev
    service: http://studio-default:3870
  # everything else
  - service: http_status:404
