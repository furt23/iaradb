# Copy to docker/studio-default.env (gitignored) and fill in. One file per Studio.
# Without the Auth0 settings below the Studio answers 503 instead of serving pages.

# Auth0 tenant domain, for example your-tenant.us.auth0.com (no https://).
AUTH0_DOMAIN=
# Auth0 Regular Web Application: client id and secret.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Key for the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Public address of this Studio, no trailing slash. Add it to the Auth0 application's
# Allowed Callback URLs (APP_BASE_URL/auth/callback) and Allowed Logout URLs.
# With IARA_VIEW_HOST (below), list both addresses separated by a comma, for example
# https://studio-default.workhouse.dev,https://view-default.workhouse.dev, and allow both in the Auth0 application.
APP_BASE_URL=https://studio-default.workhouse.dev
# Comma-separated emails that may sign in. Auth0 must report each address as verified. Empty means nobody.
IARA_ALLOWED_EMAILS=
# Comma-separated team admins. Every member may use clusters; admins may also edit or delete any cluster.
IARA_ADMIN_EMAILS=
# Comma-separated viewers: they may sign in but only open the dashboards shared with them (/view). An email also in IARA_ALLOWED_EMAILS is a member.
IARA_VIEWER_EMAILS=
# Optional second hostname for shared dashboards (bare name, no https:// or port). The tunnel sends it to this same Studio,
# which serves only /view and sign-in on it; the Studio's pages and actions are refused there, even for members.
IARA_VIEW_HOST=
# OpenAI API key for Iara and for "Ask" in the dashboard editor. Only the Studio process reads it; kernels never get it.
OPENAI_API_KEY=
# Team id: names this Studio's AWS resources so teams in one account stay apart
IARA_TEAM=default
# Team bucket: the catalog is kept at s3://<bucket>/_iara/catalog.toml, and tables created with SQL go under s3://<bucket>/warehouse/.
IARA_BUCKET=
# S3 endpoint of that bucket's store, without the bucket name (R2: https://<account_id>.r2.cloudflarestorage.com). Empty for AWS S3.
IARA_STORAGE_ENDPOINT=
# Keys of an R2 API token scoped to that bucket (32/64-character keys). Studio also copies them to the proxy
# on each cluster machine (a file only the proxy's user can read); notebook code on a cluster never has them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a region such as us-east-1 for AWS S3.
AWS_REGION=auto

# AWS account where clusters (EC2) run, if this team uses clusters. Separate from the keys above.
# These are the team's own keys, printed once by the operator's `python -m iara.cloud team-setup <team>` (run with
# admin credentials). They can only launch and end this team's machines: never put the admin keys here.
IARA_AWS_ACCESS_KEY_ID=
IARA_AWS_SECRET_ACCESS_KEY=
IARA_AWS_REGION=us-east-1
