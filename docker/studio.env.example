# Copy to docker/studio-default.env (gitignored) and fill in. One file per Studio.
# Without the Auth0 settings below the Studio answers 503 instead of serving pages.

# Auth0 tenant domain, for example your-tenant.us.auth0.com (no https://).
AUTH0_DOMAIN=
# Auth0 Regular Web Application: client id and secret.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Key for the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Public address of this Studio, no trailing slash. Add it to the Auth0 application's
# Allowed Callback URLs (APP_BASE_URL/auth/callback) and Allowed Logout URLs.
APP_BASE_URL=https://studio-default.workhouse.dev
# Comma-separated emails that may sign in. Auth0 must report each address as verified. Empty means nobody.
WORKHOUSE_ALLOWED_EMAILS=
# Comma-separated team admins. Every member may use clusters; admins may also edit or delete any cluster.
WORKHOUSE_ADMIN_EMAILS=
# Team id: names this Studio's AWS resources so teams in one account stay apart
WORKHOUSE_TEAM=default
# Object storage keys the kernels read (Cloudflare R2: 32/64-character keys from an R2 API token).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# "auto" for Cloudflare R2; a region such as us-east-1 for AWS S3.
AWS_REGION=auto

# AWS account where clusters (EC2) run, if this team uses clusters. Separate from the keys above.
WORKHOUSE_AWS_ACCESS_KEY_ID=
WORKHOUSE_AWS_SECRET_ACCESS_KEY=
WORKHOUSE_AWS_REGION=us-east-1
